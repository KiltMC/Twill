{
    "schemaVersion": 1,
    "id": "twill",
    "version": "${version}",
    "name": "Twill",
    "description": "A small development tool for NeoForge mod developers to work with Fabric.",
    "authors": [
        "BluSpring"
    ],
    "contact": {},
    "license": "LGPL-2.1-only",
    "icon": "assets/twill/icon.png",
    "environment": "*",
    "entrypoints": {
        "client": [
            "xyz.bluspring.twill.client.TwillClient"
        ],
        "main": [
            "xyz.bluspring.twill.Twill"
        ]
    },
    "mixins": [
        "twill.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=${loader_version}",
        "fabric-language-kotlin": ">=${kotlin_loader_version}",
        "fabric-api": "*",
        "minecraft": "${minecraft_version}"
    }
}
